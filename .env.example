# Supabase project URL and anon key — public, safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-side only. Never expose this to the client.
# Bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client ID (Google Cloud Console — see docs/technical/ARCHITECTURE.md's
# "Google sign-in — setup guide"). Public — the client ID is meant to be visible in the
# browser bundle. Google Sign-In is disabled until this is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Not yet wired up: the /contact form currently just logs a submission server-side
# (see lib/actions/contact.ts and DECISIONS.md). This var is a placeholder for whichever
# email provider ends up sending the notification — e.g. a Resend API key — once one is
# actually integrated.
CONTACT_NOTIFY_EMAIL=
